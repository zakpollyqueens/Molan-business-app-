{
  "name": "molan-business-app",
  "version": "1.0.0",
  "private": true,
  "description": "Molan Business web, Android, Windows, macOS and Linux desktop app builds",
  "scripts": {
    "prepare:web": "npm run prepare:icons && node scripts/prepare-web.cjs",
    "build:android": "npm run prepare:web && cap sync android",
    "build:windows": "npm run prepare:web && electron-builder --win nsis --publish never",
    "build:macos": "npm run prepare:web && electron-builder --mac dmg zip --x64 --publish never && electron-builder --mac dmg zip --arm64 --publish never",
    "build:linux": "npm run prepare:web && electron-builder --linux AppImage deb --publish never",
    "prepare:icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "6.2.1",
    "electron": "35.2.1",
    "electron-builder": "26.0.12",
    "@capacitor/assets": "^3.0.5",
    "sharp": "^0.34.4"
  },
  "build": {
    "appId": "com.zakmolanitech.molanbusiness",
    "protocols": [{ "name": "Molan Business Access", "schemes": ["molanbusiness"] }],
    "productName": "Molan Business",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "www/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "Molan Business management workspace",
      "maintainer": "Zakmolanitech Solutions <zakpollyqueens@gmail.com>",
      "icon": "assets/icon.png"
    }
  },
  "main": "desktop/main.cjs",
  "author": {
    "name": "Zakmolanitech Solutions",
    "email": "zakpollyqueens@gmail.com"
  }
}
